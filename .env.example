# ═══════════════════════════════════════════════════════════════════════
#  NexaChat — Environment Variables (.env.example)
#  এই ফাইলটি `.env` নামে কপি করে নিজের মান বসান:  cp .env.example .env
#  ⚠️  কোনো আসল secret কখনো git-এ commit করবেন না।
# ═══════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────
# Render নিজে PORT সেট করে দেয়, তাই কোডে সবসময় process.env.PORT ব্যবহৃত হয়।
PORT=3000
NODE_ENV=development

# reverse proxy (Render/Nginx) এর পেছনে থাকলে 1 রাখুন — rate-limit ও secure
# cookie সঠিকভাবে কাজ করার জন্য client IP proxy header থেকে নেওয়া হয়।
TRUST_PROXY=1

# ─── Session / JWT ─────────────────────────────────────────────────────
# JWT signing secret. Production-এ অবশ্যই লম্বা random string দিন।
# (openssl rand -hex 48)
SESSION_SECRET=change_me
# Token/cookie কতদিন বৈধ থাকবে
SESSION_TTL_DAYS=7

# ─── CORS ──────────────────────────────────────────────────────────────
# ফাঁকা রাখলে শুধু same-origin অনুমোদিত (frontend একই সার্ভার থেকেই serve হয়)।
# একাধিক origin কমা দিয়ে দিন: https://app.example.com,https://admin.example.com
CORS_ORIGIN=
# iframe embedding নীতি (CSP frame-ancestors)। Production-এ 'self' রাখুন।
FRAME_ANCESTORS=*

# ─── Metered.ca STUN/TURN (WebRTC NAT traversal) ───────────────────────
# পদ্ধতি ১ (প্রস্তাবিত): API key দিলে সার্ভার Metered API থেকে
# ephemeral TURN credential নিয়ে আসে — key কখনো frontend-এ যায় না।
METERED_API_KEY=
METERED_DOMAIN=YOUR_SUBDOMAIN.metered.live

# পদ্ধতি ২ (fallback): ড্যাশবোর্ড থেকে পাওয়া static TURN username/credential
METERED_TURN_USERNAME=
METERED_TURN_CREDENTIAL=

# ICE server তালিকা কত সেকেন্ড cache হবে
ICE_CACHE_SECONDS=600

# ─── Database ──────────────────────────────────────────────────────────
# আপাতত শুধু sqlite ড্রাইভার আছে; database.js-এর adapter interface মেনে
# ভবিষ্যতে mongodb যোগ করা যাবে।
DB_DRIVER=sqlite
DATABASE_PATH=./data/nexachat.sqlite

# ─── Media upload ──────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# ─── Chat policy ───────────────────────────────────────────────────────
# নিজের text message কত মিনিট পর্যন্ত edit করা যাবে
MESSAGE_EDIT_WINDOW_MINUTES=15
# "delete for everyone" কত মিনিট পর্যন্ত অনুমোদিত
DELETE_FOR_EVERYONE_WINDOW_MINUTES=60

# ─── Calling ───────────────────────────────────────────────────────────
# রিসিভার না ধরলে কত সেকেন্ড পর "No answer" হবে
CALL_RING_TIMEOUT_SECONDS=35

# ─── Phone normalization ───────────────────────────────────────────────
# লোকাল ফরম্যাট (01712345678) কে E.164 করার জন্য default country code
DEFAULT_COUNTRY_CODE=+880

# ─── Demo seed ─────────────────────────────────────────────────────────
# `npm run seed` দিয়ে তৈরি হওয়া ডেমো অ্যাকাউন্টগুলোর PIN
SEED_DEMO_PIN=nexa1234
