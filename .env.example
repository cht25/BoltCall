# ═══════════════════════════════════════════════════════════════
#  BoltCall — Environment Variables Template
#  এই ফাইলটি .env হিসেবে কপি করে আপনার credentials দিন
# ═══════════════════════════════════════════════════════════════

# Server port (Render স্বয়ংক্রিয়ভাবে সেট করে)
PORT=3000

# ─── Access Password ─────────────────────────────────────────
# এই password দিয়ে ব্যবহারকারীরা login করবে
ACCESS_PASSWORD=your_secret_password_here

# ─── JWT Secret — Token signing-এর জন্য ─────────────────────
JWT_SECRET=change_this_to_a_random_secret_string

# ─── Metered.ca STUN/TURN Credentials ───────────────────────
# বিনামূল্যের credentials পাবেন: https://dashboard.metered.ca
METERED_USERNAME=your_metered_username_here
METERED_CREDENTIAL=your_metered_credential_here
