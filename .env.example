# ═══════════════════════════════════════════════════════════════════════
#  BoltCall — Environment Variables (.env.example)
#  Copy to `.env` and fill in your values:   cp .env.example .env
#  ⚠️  Never commit real secrets to git.
# ═══════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────
# Render injects PORT itself; the code always prefers process.env.PORT.
PORT=3000
NODE_ENV=development

# reverse proxy (Render/Nginx) in front? keep 1 — client IP + secure
# cookies then come from proxy headers.
TRUST_PROXY=1

# ─── Session / JWT ─────────────────────────────────────────────────────
# JWT signing secret. REQUIRED in production (at least 16 chars).
#   openssl rand -hex 48
SESSION_SECRET=change_me
# How long a joined member stays signed in (they re-enter the password
# only after this expires or when they leave).
SESSION_TTL_DAYS=7

# ─── The room ──────────────────────────────────────────────────────────
# The password people enter to join the group call.
#   Option 1 (recommended for production): a bcrypt hash, so the plain
#   password never lives in the environment. Generate one with:
#     node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
#   Option 2: the plain password (min 6 chars in production).
# REQUIRED in production. If unset in development, the default
# "boltcall" is used and shown as a hint on the join screen.
ROOM_PASSWORD_HASH=
ROOM_PASSWORD=

# Display name of the room and of EVERY participant.
# BoltCall never asks anyone for a name — everyone appears as this.
ROOM_NAME=boltcall-room
MEMBER_NAME=thamjj13

# Soft cap on simultaneous participants (mesh: each pair gets its own
# peer connection — keep this sane for your network/CPU).
MAX_PARTICIPANTS=24

# ─── WebRTC ICE (STUN/TURN via Metered.ca) ────────────────────────────
# Recommended: API key — the server fetches short-lived TURN credentials
# and the key itself never reaches the browser. Without TURN, calls still
# work on most home/office networks but may fail behind strict firewalls.
METERED_API_KEY=
METERED_DOMAIN=YOUR_SUBDOMAIN.metered.live

# Alternative: static TURN credentials from the Metered dashboard.
METERED_TURN_USERNAME=
METERED_TURN_CREDENTIAL=

# How long the ICE server list is cached (seconds).
ICE_CACHE_SECONDS=600

# ─── Chat policy ───────────────────────────────────────────────────────
MAX_MESSAGE_LENGTH=1000
# In-memory session chat history (replayed to late joiners).
CHAT_HISTORY_SIZE=100

# ─── CORS (only needed if the frontend is hosted elsewhere) ───────────
# Empty = same-origin only (the frontend is served by this app).
CORS_ORIGIN=
# iframe embedding policy (CSP frame-ancestors). Production default 'self'.
FRAME_ANCESTORS=*

# ─── Rate limits (optional tuning) ─────────────────────────────────────
RL_AUTH_MAX=20            # wrong-password attempts / IP / 15 min
RL_GENERAL_MAX=1500       # general API requests / IP / 15 min
RL_SOCKET_CHAT=60         # chat messages / socket / min
RL_SOCKET_SIGNAL=600      # SDP/ICE relays / socket / min
RL_SOCKET_STATE=120       # media-state updates / socket / min
